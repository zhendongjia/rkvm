[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=09/04/2026,0.1.0.0
CatalogFile=rkvmvhid.cat
PnpLockdown=1

[DestinationDirs]
DriverCopyFiles=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
rkvmvhid.sys=1

[Manufacturer]
%ManufacturerName%=Models,NTamd64.10.0...16299

[Models.NTamd64.10.0...16299]
%DeviceDescription%=RkvmVhid_Install,Root\RKVMVHID

[RkvmVhid_Install.NT]
CopyFiles=DriverCopyFiles

[RkvmVhid_Install.NT.HW]
AddReg=RkvmVhid_LowerFilter

[RkvmVhid_LowerFilter]
HKR,,"LowerFilters",0x00010000,"vhf"

[RkvmVhid_Install.NT.Services]
AddService=rkvmvhid,0x00000002,RkvmVhid_Service

[RkvmVhid_Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\rkvmvhid.sys

[RkvmVhid_Install.NT.Wdf]
KmdfService=rkvmvhid,RkvmVhid_Wdf

[RkvmVhid_Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[DriverCopyFiles]
rkvmvhid.sys

[Strings]
ProviderName="rkvm"
ManufacturerName="rkvm"
DeviceDescription="rkvm virtual keyboard and mouse"
ServiceDescription="rkvm virtual HID source driver"
DiskName="rkvm virtual HID installation media"
